<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:tns="UitkForKsp2.MVVM.Bindings" elementFormDefault="qualified" targetNamespace="UitkForKsp2.MVVM.Bindings" xmlns:xs="http://www.w3.org/2001/XMLSchema">
